# ===== Polygon.io (Primary Data Source) =====
# Sign up at: https://polygon.io/dashboard/signup
# Free tier = 15-min delayed; Starter ($29/mo) = real-time
POLYGON_API_KEY=your_polygon_api_key_here

# ===== Alpaca Markets (Fallback Data Source — Free) =====
# Sign up at: https://app.alpaca.markets/signup  (paper trading, no money needed)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://data.alpaca.markets

# ===== Twilio (SMS Alerts) =====
# Sign up at: https://www.twilio.com/try-twilio
# Free trial gives ~$15 credit. Must verify (410) 660-4533 under Verified Caller IDs.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+14106604533
